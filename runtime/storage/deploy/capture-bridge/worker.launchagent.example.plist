<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- EXAMPLE ONLY. Never load verbatim. Substitute paths/UUID/source/label per scope.
     No auth secret belongs here. Supervisor installation is separately authorized; the kit
     installs one only through `kit.py project install` with a host archive configuration. -->
<plist version="1.0"><dict>
  <key>Label</key><string>local.ai-factory.capture.REPLACE_PROJECT</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PYTHON3</string><string>-I</string>
    <string>/MANAGED_KIT/runtime/storage/deploy/capture-bridge/capture_bridge.py</string>
    <string>--worker</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>AF_CAPTURE_PROJECT</key><string>REPLACE_PROJECT_UUID</string>
    <key>AF_CAPTURE_SOURCE</key><string>REPLACE_SOURCE</string>
    <key>AF_CAPTURE_AGENT_CREDENTIAL_FILE</key><string>/PRIVATE/PROJECT/credential.json</string>
    <key>AF_CAPTURE_QUEUE_DIR</key><string>/PRIVATE/PROJECT/capture-queue</string>
    <key>AF_CAPTURE_ENDPOINT</key><string>http://127.0.0.1:8780</string>
  </dict>
  <key>StandardErrorPath</key><string>/PRIVATE/PROJECT/capture-worker.status.log</string>
  <key>Umask</key><integer>63</integer>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>ProcessType</key><string>Background</string>
</dict></plist>
