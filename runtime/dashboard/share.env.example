# Copy outside the repository to share.env and edit before running the launcher.
# Any HTTPS tunnel or share service works; use the hostname and domain it gives you.
# Optional: DASHBOARD_DOCKER_CONTEXT / DASHBOARD_BUILDER pick the Docker engine and builder.
# Use the exact hostname issued by your share provider, without a scheme, port, or path.
# If the provider changes the random suffix on every restart, end the first label in *: dashboard-*.share.example.test
export DASHBOARD_SHARE_HOST=dashboard.share.example.test
# The provider's domain: the hostname must be exactly one label under it.
export DASHBOARD_SHARE_DOMAIN=share.example.test
# off: all requests to the share listener return 403. on: require a listed login.
export DASHBOARD_SHARE_AUTH=off
# Use an absolute path to a private file with mode 0600.
export DASHBOARD_SHARE_DIGEST="$HOME/.config/factory-dashboard/share.accounts"
